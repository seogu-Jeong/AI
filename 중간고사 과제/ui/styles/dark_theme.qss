/* === GLOBAL === */
QMainWindow, QWidget {
    background-color: #000000; /* bg_base */
    color: #EEEEEE; /* text_primary */
    font-family: 'Segoe UI', 'Noto Sans KR', sans-serif;
    font-size: 13px;
}

/* === SIDEBAR === */
QListWidget#sidebar {
    background-color: #050505; /* sidebar_bg */
    border: none;
    border-right: 1px solid #1E1E1E; /* border */
    outline: none;
    padding: 8px 0;
}
QListWidget#sidebar::item {
    height: 48px;
    color: #9E9E9E; /* text_secondary */
    padding: 0 20px;
    border-left: 3px solid transparent;
    border-radius: 0;
    font-size: 13px;
    font-weight: 500;
}
QListWidget#sidebar::item:hover {
    background-color: #222222; /* bg_hover */
    color: #EEEEEE; /* text_primary */
}
QListWidget#sidebar::item:selected {
    background-color: #1A1A1A; /* bg_elevated */
    color: #FF6D00; /* accent */
    border-left: 3px solid #FF6D00; /* accent */
    font-weight: 600;
}

/* === TABLE === */
QTableWidget {
    background-color: #0A0A0A; /* bg_surface */
    alternate-background-color: #000000; /* bg_base */
    gridline-color: #1E1E1E; /* border */
    border: none;
    font-size: 13px;
    selection-background-color: #1A1A1A; /* bg_elevated */
    font-family: 'Consolas', 'Courier New', monospace;
}
QTableWidget::item {
    padding: 10px 12px;
    border-bottom: 1px solid #1E1E1E; /* border */
    color: #EEEEEE; /* text_primary */
}
QTableWidget::item:selected {
    background-color: #1A1A1A; /* bg_elevated */
    color: #EEEEEE; /* text_primary */
}
QTableWidget::item:hover {
    background-color: #222222; /* bg_hover */
}
QHeaderView::section {
    background-color: #050505; /* sidebar_bg */
    color: #9E9E9E; /* text_secondary */
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #1E1E1E; /* border */
    border-right: 1px solid #1E1E1E; /* border */
}

/* === BUTTONS === */
QPushButton {
    background-color: #CC5500; /* accent_glow */
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 18px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
}
QPushButton:hover {
    background-color: #FF6D00; /* accent */
    border: 1px solid #FF8F00; /* accent_light */
}
QPushButton:pressed {
    background-color: #CC5500; /* sidebar_sel */
}
QPushButton#secondary {
    background-color: #1A1A1A; /* bg_elevated */
    color: #EEEEEE; /* text_primary */
    border: 1px solid #FF6D0033; /* border_bright */
}
QPushButton#secondary:hover {
    background-color: #222222; /* bg_hover */
    border: 1px solid #FF6D00; /* accent */
}
QPushButton#ghost {
    background-color: transparent;
    color: #9E9E9E; /* text_secondary */
    border: none;
    padding: 6px 12px;
}
QPushButton#ghost:hover {
    color: #EEEEEE; /* text_primary */
    background-color: #1A1A1A; /* bg_elevated */
    border-radius: 4px;
}

/* === INPUTS === */
QLineEdit, QComboBox {
    background-color: #1A1A1A; /* bg_elevated */
    color: #EEEEEE; /* text_primary */
    border: 1px solid #1E1E1E; /* border */
    border-radius: 4px;
    padding: 7px 12px;
    font-size: 13px;
    font-family: 'Consolas', 'Courier New', monospace;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #FF6D00; /* accent */
}
QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #1A1A1A; /* bg_elevated */
    color: #EEEEEE; /* text_primary */
    border: 1px solid #FF6D0033; /* border_bright */
    selection-background-color: #CC5500; /* accent_glow */
}

/* === PROGRESS BARS === */
QProgressBar {
    background-color: #1A1A1A; /* bg_elevated */
    border: none;
    border-radius: 2px;
    height: 6px;
    text-align: center;
    font-size: 10px;
    color: transparent;
}
QProgressBar::chunk {
    border-radius: 2px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #CC5500, stop:1 #FF6D00); /* accent_glow, accent */
}

/* === SCROLLBAR === */
QScrollBar:vertical {
    background: #000000; /* bg_base */
    width: 8px;
    border-radius: 0px;
}
QScrollBar::handle:vertical {
    background: #1A1A1A; /* bg_elevated */
    border-radius: 0px;
    min-height: 40px;
}
QScrollBar::handle:vertical:hover {
    background: #555555; /* text_muted */
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: #000000; /* bg_base */
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #1A1A1A; /* bg_elevated */
    border-radius: 0px;
}

/* === FRAMES / CARDS === */
QFrame#card {
    background-color: #111111; /* bg_card */
    border: 1px solid #1E1E1E; /* border */
    border-radius: 4px;
}
QFrame#card_highlight {
    background-color: #111111; /* bg_card */
    border: 1px solid #FF6D0033; /* border_bright */
    border-radius: 4px;
}

/* === LABELS === */
QLabel#disclaimer {
    background-color: #050505; /* sidebar_bg */
    color: #555555; /* text_muted */
    font-size: 11px;
    padding: 4px 16px;
    border-top: 1px solid #1E1E1E; /* border */
    font-family: 'Consolas', 'Courier New', monospace;
}
QLabel#page_title {
    font-size: 20px;
    font-weight: 700;
    color: #EEEEEE; /* text_primary */
    text-transform: uppercase;
    letter-spacing: 1px;
}
QLabel#section_title {
    font-size: 11px;
    font-weight: 600;
    color: #9E9E9E; /* text_secondary */
    text-transform: uppercase;
    letter-spacing: 1.5px;
}

/* === RADIO BUTTONS === */
QRadioButton {
    color: #EEEEEE; /* text_primary */
    spacing: 8px;
}
QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 2px solid #1E1E1E; /* border */
    border-radius: 8px;
    background: #1A1A1A; /* bg_elevated */
}
QRadioButton::indicator:checked {
    background: #FF6D00; /* accent */
    border: 2px solid #FF6D00; /* accent */
}

/* === TOOLTIP === */
QToolTip {
    background-color: #1A1A1A; /* bg_elevated */
    color: #EEEEEE; /* text_primary */
    border: 1px solid #FF6D00; /* accent */
    border-radius: 2px;
    padding: 6px 10px;
    font-size: 12px;
}

/* === DIALOG === */
QDialog {
    background-color: #0A0A0A; /* bg_surface */
}

/* === SPLITTER === */
QSplitter::handle {
    background-color: #1E1E1E; /* border */
}